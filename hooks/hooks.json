{
  "description": "active-memory (Claude Code only): counts messages to trigger checkpoints at 20 and 35, and checks that each reply starts with the active code word.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/on_prompt.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_codeword.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
