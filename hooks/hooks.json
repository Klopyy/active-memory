{
  "description": "active-memory (Claude Code only): counts messages to trigger checkpoints at 20 and 35, and checks that each reply starts with the active code word. Runs with whichever Python is installed (py, python3 or python); if none is found, the hooks quietly do nothing.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/on_prompt.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/on_prompt.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/on_prompt.py\" || exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_codeword.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_codeword.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_codeword.py\" || exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
